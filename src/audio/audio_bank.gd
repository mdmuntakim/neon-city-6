class_name AudioBank
extends Node
## Loads the repository's generated WAVs and owns the music/engine/siren/SFX
## players. All audio is original and generated by tools/gen_assets.py.

const TRACKS := ["intro_theme", "menu_theme", "radio_synth", "radio_beat", "radio_electro"]
const SFX := ["ui_click", "pickup", "crash", "mission_complete", "jump",
		"enter_car", "mission_fail", "radio_switch"]
const LOOPS := ["intro_theme", "menu_theme", "radio_synth", "radio_beat", "radio_electro",
		"engine_loop", "siren_loop"]

var music: AudioStreamPlayer
var engine: AudioStreamPlayer
var siren: AudioStreamPlayer
var _pool: Array[AudioStreamPlayer] = []
var _cache := {}
var _music_name := ""


func _ready() -> void:
	music = _make_player(-9.0)
	engine = _make_player(-14.0)
	siren = _make_player(-11.0)
	for i in 8:
		_pool.append(_make_player(-6.0))


func _make_player(db: float) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.volume_db = db
	add_child(p)
	return p


func _stream(name_: String) -> AudioStream:
	if _cache.has(name_):
		return _cache[name_]
	var path := "res://assets/audio/%s.wav" % name_
	if not ResourceLoader.exists(path):
		_cache[name_] = null
		return null
	var s := load(path) as AudioStream
	if s is AudioStreamWAV and name_ in LOOPS:
		var w := s as AudioStreamWAV
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
		w.loop_begin = 0
		w.loop_end = int(w.data.size() / 2) if w.format == AudioStreamWAV.FORMAT_16_BITS else w.loop_end
	_cache[name_] = s
	return s


func play_music(name_: String, volume_db := -9.0) -> void:
	if _music_name == name_ and music.playing:
		return
	var s := _stream(name_)
	if s == null:
		return
	_music_name = name_
	music.stream = s
	music.volume_db = volume_db
	music.play()


func stop_music() -> void:
	_music_name = ""
	music.stop()


func sfx(name_: String, volume_db := 0.0, pitch := 1.0) -> void:
	var s := _stream(name_)
	if s == null:
		return
	for p in _pool:
		if not p.playing:
			p.stream = s
			p.volume_db = volume_db
			p.pitch_scale = pitch
			p.play()
			return
	_pool[0].stream = s
	_pool[0].volume_db = volume_db
	_pool[0].pitch_scale = pitch
	_pool[0].play()


func set_engine(on: bool, ratio := 0.0) -> void:
	if on:
		if engine.stream == null:
			engine.stream = _stream("engine_loop")
		if engine.stream != null and not engine.playing:
			engine.play()
		engine.pitch_scale = 0.65 + ratio * 1.5
		engine.volume_db = -18.0 + ratio * 6.0
	elif engine.playing:
		engine.stop()


func set_siren(on: bool) -> void:
	if on:
		if siren.stream == null:
			siren.stream = _stream("siren_loop")
		if siren.stream != null and not siren.playing:
			siren.play()
	elif siren.playing:
		siren.stop()
